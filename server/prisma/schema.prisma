generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  SERVICE_ADVISOR
  MECHANIC
  STORE_MANAGER
  ACCOUNTANT
  CUSTOMER
}

enum JobStatus {
  RECEIVED
  INSPECTION
  ESTIMATION
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  QUALITY_CHECK
  COMPLETED
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum StockType {
  PURCHASE
  USAGE
  ADJUSTMENT
  RETURN
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(ADMIN)
  phone        String?
  avatar       String?
  isActive     Boolean     @default(true)
  specialty    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tasks        JobTask[]   @relation("MechanicTasks")
  inspections  VehicleInspection[]
  qualityChecks QualityInspection[]
}

model Customer {
  id             String            @id @default(uuid())
  name           String
  phone          String            @unique
  email          String?
  address        String?
  gstNumber      String?
  city           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  vehicles       Vehicle[]
  appointments   Appointment[]
  inwardRecords  InwardRecord[]
  jobCards       JobCard[]
  invoices       Invoice[]
  payments       Payment[]
  complaints     CustomerComplaint[]
  reminders      ServiceReminder[]
}

model Vehicle {
  id                 String            @id @default(uuid())
  registrationNumber String            @unique
  make               String
  model              String
  year               Int
  color              String?
  vin                String?
  fuelType           String            @default("Petrol") // Petrol, Diesel, EV, Hybrid, CNG
  mileage            Int               @default(0)
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  appointments       Appointment[]
  inwardRecords      InwardRecord[]
  jobCards           JobCard[]
  reminders          ServiceReminder[]
}

model Appointment {
  id                String    @id @default(uuid())
  appointmentNumber String    @unique
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  vehicleId         String
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
  appointmentDate   DateTime
  serviceType       String
  notes             String?
  status            String    @default("CONFIRMED") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model InwardRecord {
  id                String    @id @default(uuid())
  gateEntryNumber   String    @unique
  vehicleId         String
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  odometerReading   Int
  fuelLevel         String    // E.g., 25%, 50%, 75%, Full
  personalBelongings String?
  scratchDamageNotes String?
  inwardDate        DateTime  @default(now())
  status            String    @default("IN_GARAGE")
  jobCard           JobCard?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model JobCard {
  id                String               @id @default(uuid())
  jobCardNumber     String               @unique
  customerId        String
  customer          Customer             @relation(fields: [customerId], references: [id])
  vehicleId         String
  vehicle           Vehicle              @relation(fields: [vehicleId], references: [id])
  inwardRecordId    String?              @unique
  inwardRecord      InwardRecord?        @relation(fields: [inwardRecordId], references: [id])
  status            JobStatus            @default(RECEIVED)
  priority          Priority             @default(NORMAL)
  serviceType       String               @default("Full Service")
  customerConcerns  String?
  promisedDate      DateTime?
  estimatedCost     Float                @default(0)
  actualCost        Float                @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  inspection        VehicleInspection?
  estimate          Estimate?
  tasks             JobTask[]
  partsUsed         PartUsage[]
  qualityCheck      QualityInspection?
  deliveryRecord    DeliveryRecord?
  invoice           Invoice?
  warrantyClaims    WarrantyClaim[]
  complaints        CustomerComplaint[]
}

model VehicleInspection {
  id                 String    @id @default(uuid())
  jobCardId          String    @unique
  jobCard            JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  inspectorId        String?
  inspector          User?     @relation(fields: [inspectorId], references: [id])
  engineOil          String    @default("GOOD") // GOOD, LOW, REPLACE
  brakeCondition     String    @default("GOOD")
  tyreCondition      String    @default("GOOD")
  batteryHealth      String    @default("GOOD")
  electricalLights   String    @default("GOOD")
  suspension         String    @default("GOOD")
  bodyDamageDetails  String?
  overallPassed      Boolean   @default(true)
  inspectionNotes    String?
  inspectedAt        DateTime  @default(now())
}

model Estimate {
  id              String         @id @default(uuid())
  estimateNumber  String         @unique
  jobCardId       String         @unique
  jobCard         JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  subtotal        Float          @default(0)
  taxRate         Float          @default(18.0)
  taxAmount       Float          @default(0)
  grandTotal      Float          @default(0)
  status          EstimateStatus @default(DRAFT)
  approvedAt      DateTime?
  customerNotes   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           EstimateItem[]
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  itemType    String   @default("LABOR") // LABOR or PART
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
}

model JobTask {
  id          String     @id @default(uuid())
  jobCardId   String
  jobCard     JobCard    @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  description String
  mechanicId  String?
  mechanic    User?      @relation("MechanicTasks", fields: [mechanicId], references: [id])
  laborCost   Float      @default(0)
  status      TaskStatus @default(PENDING)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SparePart {
  id            String          @id @default(uuid())
  partNumber    String          @unique
  name          String
  category      String          @default("General") // Engine, Brakes, Suspension, Electrical, Filters, Lubes
  unit          String          @default("pcs")
  costPrice     Float           @default(0)
  sellingPrice  Float           @default(0)
  stockQuantity Int             @default(0)
  minStockLevel Int             @default(5)
  rackLocation  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  partUsages    PartUsage[]
  movements     StockMovement[]
  poItems       PurchaseOrderItem[]
  warrantyClaims WarrantyClaim[]
}

model PartUsage {
  id          String    @id @default(uuid())
  jobCardId   String
  jobCard     JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)
  total       Float     @default(0)
  usedAt      DateTime  @default(now())
}

model StockMovement {
  id          String    @id @default(uuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  type        StockType
  quantity    Int
  balanceAfter Int
  reason      String?
  referenceNo String?
  createdAt   DateTime  @default(now())
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  gstin          String?
  balance        Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  totalAmount   Float               @default(0)
  status        String              @default("ORDERED") // ORDERED, RECEIVED, CANCELLED
  orderDate     DateTime            @default(now())
  receivedDate  DateTime?
  items         PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sparePartId     String
  sparePart       SparePart     @relation(fields: [sparePartId], references: [id])
  quantity        Int
  unitCost        Float
  total           Float
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  jobCardId     String        @unique
  jobCard       JobCard       @relation(fields: [jobCardId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  subtotal      Float         @default(0)
  taxRate       Float         @default(18.0)
  taxAmount     Float         @default(0)
  discount      Float         @default(0)
  grandTotal    Float         @default(0)
  paidAmount    Float         @default(0)
  balanceAmount Float         @default(0)
  status        PaymentStatus @default(UNPAID)
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  paymentNumber String   @unique
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amount        Float
  method        String   @default("UPI") // CASH, CARD, UPI, BANK_TRANSFER
  transactionRef String?
  paymentDate   DateTime @default(now())
  notes         String?
}

model QualityInspection {
  id                String   @id @default(uuid())
  jobCardId         String   @unique
  jobCard           JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  inspectorId       String?
  inspector         User?    @relation(fields: [inspectorId], references: [id])
  roadTestDone      Boolean  @default(true)
  cleanlinessDone   Boolean  @default(true)
  allTasksVerified  Boolean  @default(true)
  passed            Boolean  @default(true)
  comments          String?
  inspectedAt       DateTime @default(now())
}

model DeliveryRecord {
  id              String   @id @default(uuid())
  jobCardId       String   @unique
  jobCard         JobCard  @relation(fields: [jobCardId], references: [id])
  gatePassNumber  String   @unique
  deliveredTo     String
  deliveryDate    DateTime @default(now())
  exitOdometer    Int?
  fuelLevelOnExit String?
  customerRating  Int      @default(5)
  feedback        String?
  createdAt       DateTime @default(now())
}

model ServiceReminder {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  reminderType String   @default("PERIODIC_SERVICE") // PERIODIC_SERVICE, INSURANCE, PUC, WHEEL_ALIGNMENT
  dueDate      DateTime
  status       String   @default("PENDING") // PENDING, SENT, COMPLETED
  notes        String?
  createdAt    DateTime @default(now())
}

model WarrantyClaim {
  id           String     @id @default(uuid())
  jobCardId    String
  jobCard      JobCard    @relation(fields: [jobCardId], references: [id])
  sparePartId  String?
  sparePart    SparePart? @relation(fields: [sparePartId], references: [id])
  claimDate    DateTime   @default(now())
  description  String
  status       String     @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  settledAmount Float     @default(0)
}

model CustomerComplaint {
  id             String   @id @default(uuid())
  jobCardId      String
  jobCard        JobCard  @relation(fields: [jobCardId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  description    String
  reworkRequired Boolean  @default(false)
  status         String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Expense {
  id            String   @id @default(uuid())
  expenseNumber String   @unique
  category      String   // E.g., Electricity, Tools, Rent, Tea/Snacks, Consumables, Salaries
  amount        Float
  paymentMethod String   @default("CASH")
  description   String
  paidTo        String
  expenseDate   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, PAYMENT, STOCK_ISSUE
  entity      String   // JobCard, Invoice, Inventory, Customer, Delivery
  entityId    String?
  performedBy String   @default("Admin User")
  details     String?
  createdAt   DateTime @default(now())
}

model GarageSetting {
  id             String  @id @default("default")
  garageName     String  @default("GaragePro Auto Works")
  tagline        String  @default("The OS for Modern Garages")
  phone          String  @default("+91 98765 43210")
  email          String  @default("contact@garagepro.service")
  address        String  @default("Plot 42, Automobile Hub, Sector 18, MIDC")
  gstin          String  @default("27ABCDE1234F1Z5")
  taxRatePercent Float   @default(18.0)
  currencySymbol String  @default("₹")
}

